# Copia questo file in server/.env e inserisci i valori reali.
# Li trovi nel tuo firebaseAccount.json (campi project_id, client_email, private_key).

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Mantieni le virgolette e lascia \n dove il JSON ha gli a capo
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nINSERISCI_QUI\n-----END PRIVATE KEY-----\n"

PORT=4000
